<Window x:Class="TuneHalo.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuneHalo" Width="72" Height="72" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False">
  <Grid x:Name="Root" Cursor="Hand" RenderTransformOrigin="0.5,0.5" Background="Transparent">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
    </Grid.RenderTransform>

    <!-- base disc -->
    <Ellipse Margin="6" Fill="#F0181818" Stroke="#30FFFFFF" StrokeThickness="1">
      <Ellipse.Effect>
        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.55" Color="Black"/>
      </Ellipse.Effect>
    </Ellipse>

    <!-- album cover, or a note when there is none -->
    <TextBlock x:Name="NoteIcon" Text="&#xEC4F;" FontFamily="{StaticResource Icons}" FontSize="20"
               Foreground="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Ellipse x:Name="Cover" Margin="11"/>

    <!-- paused state -->
    <Grid x:Name="PausedLayer" Visibility="Collapsed">
      <Ellipse Margin="11" Fill="#A0000000"/>
      <TextBlock Text="&#xE769;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="White"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <!-- track progress -->
    <Path x:Name="Progress" Stroke="{StaticResource Green}" StrokeThickness="3"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>

    <!-- hotkey feedback (fades in and out) -->
    <Grid x:Name="Osd" Opacity="0" IsHitTestVisible="False">
      <Ellipse Margin="11" Fill="#E0000000"/>
      <TextBlock x:Name="OsdText" Foreground="White" FontSize="13" FontWeight="SemiBold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

    <!-- liked badge -->
    <Border x:Name="LikeBadge" Width="20" Height="20" CornerRadius="10" Background="#FF121212"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock Text="&#xEB52;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{StaticResource Green}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
