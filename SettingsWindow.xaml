<Window x:Class="TuneHalo.SettingsWindow" Icon="/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuneHalo — Paramètres" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#18181B" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="H">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="0,18,0,8"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="Hint">
      <Setter Property="Foreground" Value="#9A9A9A"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#26262B"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#3B3B42"/>
      <Setter Property="Padding" Value="6,5"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="22,8,22,20">
    <!-- hotkeys -->
    <TextBlock Style="{StaticResource H}" Text="Raccourcis clavier (pavé numérique)"/>
    <CheckBox x:Name="HotkeysCheck" Content="Activer les raccourcis globaux"/>
    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
      <TextBlock Text="Touche(s) à maintenir :" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox x:Name="ModifierCombo" Width="140"/>
    </StackPanel>
    <Border Background="#202024" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
      <ItemsControl x:Name="LayoutList"/>
    </Border>
    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
               Text="Le Verr. Num doit être activé. La molette sur la bulle règle le volume, le clic milieu met en pause."/>

    <!-- like -->
    <TextBlock Style="{StaticResource H}" Text="Like (compte Spotify)"/>
    <TextBlock Style="{StaticResource Hint}">
      Lecture, pause, suivant et volume marchent sans compte. Pour le like, il faut une app sur
      <Hyperlink x:Name="DashboardLink" NavigateUri="https://developer.spotify.com/dashboard" Foreground="#1DB954">developer.spotify.com/dashboard</Hyperlink> :
      « Create app », cochez « Web API », ajoutez l'URI de redirection ci-dessous, puis copiez le Client ID ici.
    </TextBlock>
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Text="Redirect URI" VerticalAlignment="Center"/>
      <TextBox x:Name="RedirectBox" Grid.Column="1" IsReadOnly="True"/>
      <Button x:Name="CopyButton" Grid.Column="2" Style="{StaticResource FlatButton}" Content="Copier" Margin="8,0,0,0"/>
      <TextBlock Grid.Row="1" Text="Client ID" VerticalAlignment="Center" Margin="0,8,0,0"/>
      <TextBox x:Name="ClientIdBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="ConnectButton" Style="{StaticResource FlatButton}" Content="Connecter Spotify" Background="#1DB954" Foreground="Black"/>
      <Button x:Name="DisconnectButton" Style="{StaticResource FlatButton}" Content="Déconnecter" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" Margin="0,8,0,0"/>

    <!-- general -->
    <TextBlock Style="{StaticResource H}" Text="Général"/>
    <CheckBox x:Name="BubbleCheck" Content="Afficher la bulle flottante"/>
    <CheckBox x:Name="AutoStartCheck" Content="Lancer TuneHalo au démarrage de Windows"/>

    <Button x:Name="CloseButton" Style="{StaticResource FlatButton}" Content="Fermer" HorizontalAlignment="Right" Margin="0,16,0,0"/>
  </StackPanel>
</Window>
